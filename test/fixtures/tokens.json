{
  "meta": {
    "name": "Stillwater",
    "toneWords": ["quiet confidence", "earned slowness", "warm minimalism"],
    "manifesto": "Stillwater is the ten minutes she gives back to herself. Every surface is warm, every motion unhurried, every word chosen. Nothing competes for her attention, because her attention is the point.",
    "accentAsText": true
  },
  "color": {
    "primary":     { "$type": "color", "$value": "#55705A", "$extensions": { "design-direction": { "dark": "#9DB59F" } } },
    "on-primary":  { "$type": "color", "$value": "#FBF8F3", "$extensions": { "design-direction": { "dark": "#1C211D" } } },
    "secondary":   { "$type": "color", "$value": "#A9B8A3", "$extensions": { "design-direction": { "dark": "#4A5A4C" } } },
    "accent":      { "$type": "color", "$value": "#A65A40", "$extensions": { "design-direction": { "dark": "#D9937A" } } },
    "background":  { "$type": "color", "$value": "#F7F3EC", "$extensions": { "design-direction": { "dark": "#1A1C19" } } },
    "surface":     { "$type": "color", "$value": "#FCFAF6", "$extensions": { "design-direction": { "dark": "#232622" } } },
    "neutral-100": { "$type": "color", "$value": "#EDE8DF", "$extensions": { "design-direction": { "dark": "#2C2F2B" } } },
    "neutral-300": { "$type": "color", "$value": "#D3CCC0", "$extensions": { "design-direction": { "dark": "#464A44" } } },
    "neutral-600": { "$type": "color", "$value": "#6B655C", "$extensions": { "design-direction": { "dark": "#A9A398" } } },
    "neutral-900": { "$type": "color", "$value": "#2E2B27", "$extensions": { "design-direction": { "dark": "#ECE6DC" } } },
    "success":     { "$type": "color", "$value": "#4F7A5A", "$extensions": { "design-direction": { "dark": "#8DBF97" } } },
    "warning":     { "$type": "color", "$value": "#94661F", "$extensions": { "design-direction": { "dark": "#D9AE6A" } } },
    "error":       { "$type": "color", "$value": "#A84A3C", "$extensions": { "design-direction": { "dark": "#E08A7A" } } },
    "info":        { "$type": "color", "$value": "#4F6B82", "$extensions": { "design-direction": { "dark": "#94AFC4" } } }
  },
  "font": {
    "heading": { "$type": "fontFamily", "$value": ["Fraunces", "Georgia", "serif"] },
    "body":    { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] }
  },
  "typography": {
    "h1":      { "$type": "typography", "$value": { "fontFamily": "{font.heading}", "fontSize": "48px", "fontWeight": 300, "lineHeight": 1.15, "letterSpacing": "-0.01em" } },
    "h2":      { "$type": "typography", "$value": { "fontFamily": "{font.heading}", "fontSize": "36px", "fontWeight": 300, "lineHeight": 1.2,  "letterSpacing": "0" } },
    "h3":      { "$type": "typography", "$value": { "fontFamily": "{font.heading}", "fontSize": "24px", "fontWeight": 400, "lineHeight": 1.3,  "letterSpacing": "0" } },
    "body":    { "$type": "typography", "$value": { "fontFamily": "{font.body}",    "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.6,  "letterSpacing": "0" } },
    "caption": { "$type": "typography", "$value": { "fontFamily": "{font.body}",    "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.5,  "letterSpacing": "0.01em" } },
    "label":   { "$type": "typography", "$value": { "fontFamily": "{font.body}",    "fontSize": "12px", "fontWeight": 500, "lineHeight": 1.4,  "letterSpacing": "0.06em" } }
  },
  "spacing": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "8px" },
    "md":   { "$type": "dimension", "$value": "12px" },
    "pill": { "$type": "dimension", "$value": "9999px" }
  },
  "shadow": {
    "card": { "$type": "shadow", "$value": "0 2px 8px rgba(46, 43, 39, 0.06)" }
  }
}
